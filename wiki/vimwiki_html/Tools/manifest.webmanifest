{
  "name": "Calo",
  "short_name": "Calo",
  "description": "A vegetarian calorie and energy tracker. Log food, lifting and housework, and see whether the difference becomes fat or muscle. All data stays on your device.",
  "id": "/wiki/vimwiki_html/Tools/calorie_counter.html",
  "start_url": "calorie_counter.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#141917",
  "theme_color": "#141917",
  "categories": ["health", "fitness", "lifestyle"],
  "lang": "en",
  "dir": "ltr",
  "icons": [
    {
      "src": "ledger/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "ledger/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "ledger/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Log food",
      "short_name": "Food",
      "url": "calorie_counter.html?action=food",
      "icons": [{ "src": "ledger/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Log a workout",
      "short_name": "Workout",
      "url": "calorie_counter.html?action=train",
      "icons": [{ "src": "ledger/icons/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
